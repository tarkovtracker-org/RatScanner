{
  "name": "ratscanner",
  "private": true,
  "description": "Dev-only Node tooling for markdown lint (not a runtime dependency).",
  "scripts": {
    "lint:md": "markdownlint \"**/*.md\"",
    "lint:md:fix": "markdownlint --fix \"**/*.md\""
  },
  "devDependencies": {
    "markdownlint-cli": "0.49.1"
  },
  "overrides": {
    "js-yaml": "5.4.3",
    "smol-toml": "1.9.1"
  }
}
